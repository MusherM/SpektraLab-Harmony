#version 450
#extension GL_GOOGLE_include_directive : require
#include "spk_rng.glsl"

// Bit-exact optimization: cache small curve & layer parameter tables in shared memory.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Cmy { float cmy[]; };
layout(std430, binding = 1) readonly buffer Xa { float xa[]; };
layout(std430, binding = 2) readonly buffer Inv { float inv[]; };
layout(std430, binding = 3) readonly buffer Ylay { float ylay[]; };
layout(std430, binding = 4) readonly buffer Lp { float lp[]; };
layout(std430, binding = 5) readonly buffer Streams { uint streams[]; };
layout(std430, binding = 6) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 7) writeonly buffer Out { float dst[]; };

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

shared float s_xa[768];    // up to 256 * 3
shared float s_inv[768];   // up to 256 * 3
shared float s_lp[36];
shared uint s_streams[9];

uint search_right_shared(uint K, uint ch, float v) {
    uint lo = 0u, hi = K;
    while (lo < hi) { uint mid = lo + ((hi - lo) >> 1); if (s_xa[mid * 3u + ch] <= v) lo = mid + 1u; else hi = mid; }
    return lo;
}
uint search_right_global(uint K, uint ch, float v) {
    uint lo = 0u, hi = K;
    while (lo < hi) { uint mid = lo + ((hi - lo) >> 1); if (xa[mid * 3u + ch] <= v) lo = mid + 1u; else hi = mid; }
    return lo;
}

void main() {
    uint K = meta[0], n = meta[1], positive = meta[2], seed = meta[3];
    uint lid = gl_LocalInvocationID.x;
    bool use_shared = (K <= 256u);
    if (use_shared) {
        if (lid < K) {
            s_xa[3u * lid]      = xa[3u * lid];
            s_xa[3u * lid + 1u] = xa[3u * lid + 1u];
            s_xa[3u * lid + 2u] = xa[3u * lid + 2u];
            if (lid + 1u < K) {
                s_inv[3u * lid]      = inv[3u * lid];
                s_inv[3u * lid + 1u] = inv[3u * lid + 1u];
                s_inv[3u * lid + 2u] = inv[3u * lid + 2u];
            }
        }
        if (lid < 36u) s_lp[lid] = lp[lid];
        if (lid < 9u) s_streams[lid] = streams[lid];
        barrier();
    }

    uint i = spk_global_index();
    if (i >= n) return;
    for (uint ch = 0u; ch < 3u; ++ch) {
        precise float v = cmy[3u * i + ch];
        if (positive != 0u) v = -v;
        float x0 = use_shared ? s_xa[ch] : xa[ch];
        float xN = use_shared ? s_xa[(K - 1u) * 3u + ch] : xa[(K - 1u) * 3u + ch];
        uint low = 0u; precise float t = 0.0; int mode;
        if (v <= x0) mode = 0; else if (v >= xN) mode = 1; else {
            uint idx = use_shared ? search_right_shared(K, ch, v) : search_right_global(K, ch, v);
            low = idx - 1u;
            t = use_shared ? (v - s_xa[low * 3u + ch]) * s_inv[low * 3u + ch]
                           : (v - xa[low * 3u + ch]) * inv[low * 3u + ch];
            mode = 2;
        }
        precise float acc = 0.0;
        for (uint sl = 0u; sl < 3u; ++sl) {
            uint col = ch * 3u + sl;
            precise float d;
            if (mode == 0) d = ylay[col];
            else if (mode == 1) d = ylay[(K - 1u) * 9u + col];
            else { float y0 = ylay[low * 9u + col], y1 = ylay[(low + 1u) * 9u + col]; d = y0 + t * (y1 - y0); }
            float lp0 = use_shared ? s_lp[4u * col] : lp[4u * col];
            float lp1 = use_shared ? s_lp[4u * col + 1u] : lp[4u * col + 1u];
            float lp2 = use_shared ? s_lp[4u * col + 2u] : lp[4u * col + 2u];
            float lp3 = use_shared ? s_lp[4u * col + 3u] : lp[4u * col + 3u];
            uint st = use_shared ? s_streams[col] : streams[col];
            d += lp0;
            Rng rng = rng_init(i, st, seed);
            acc += layer_draw(rng, d, lp1, lp2, lp3);
        }
        dst[3u * i + ch] = acc;
    }
}

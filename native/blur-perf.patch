+bool iir_coalesced(gpu::Gpu* gpu, Blur::SweepReport* sweep_report, const Image& img,
+                   const Image* pre_transposed, const double sigmas[3], const bool active[3],
+                   Image& out, std::string& error, const Image* acc, const double* weight,
+                   bool use_f32 = false) {
+    float coef[24] = {};
+    uint32_t act[3] = {0, 0, 0};
+    bool any = false;
+    for (int c = 0; c < 3; ++c) {
+        if (!(active[c] && sigmas[c] > 0.0)) continue;
+        double b[4];
+        yvv_coeffs(sigmas[c], b);
+        for (int j = 0; j < 4; ++j) {
+            const auto hl = split(b[j]);
+            coef[8 * c + 2 * j] = hl.first;
+            coef[8 * c + 2 * j + 1] = hl.second;
+        }
+        act[c] = 1;
+        any = true;
+    }
+    if (!any && !acc) { out = img; return true; }
+
+    gpu::BufferRef coef_buf = gpu->upload(coef, sizeof coef, error);
+    gpu::BufferRef act_buf = gpu->upload_u32(act, 3, error);
+    if (!coef_buf || !act_buf) return false;
+    double wt[3];
+    broadcast3(weight, wt, 1.0);
+    const float wtf[3] = {float(wt[0]), float(wt[1]), float(wt[2])};
+    gpu::BufferRef wt_buf = gpu->upload(wtf, sizeof wtf, error);
+    if (!wt_buf) return false;
+
+    // Bit-exact coalesced horizontal IIR:
+    // Transpose (H, W) -> (W, H), run coalesced vertical IIR (axis = 0) on (W, H)
+    // which performs the exact same horizontal recurrence in the exact same order,
+    // transpose back (W, H) -> (H, W), then run coalesced vertical IIR (axis = 0)
+    // in place with optional multiply-add accumulation.
+    Image owned_T;
+    const Image* img_T = pre_transposed;
+    if (!img_T || !img_T->buf) {
+        if (!transpose3(gpu, img, owned_T, error)) return false;
+        img_T = &owned_T;
+    }
+
+    Image tmp_T;
+    tmp_T.h = img_T->h; tmp_T.w = img_T->w; tmp_T.c = img_T->c;
+    tmp_T.buf = gpu->alloc(img_T->bytes(), error);
+    if (!tmp_T.buf) return false;
+
+    const Image* dummy = acc ? acc : &img;
+    // Pass 1 (horizontal on original == vertical axis=0 on transposed (W, H)):
+    const char* iir_kern = use_f32 ? "spk_iir_f32_acc" : "spk_iir_df_acc";
+    const uint32_t meta_h_t[4] = {img_T->h, img_T->w, 0u, 0u};
+    if (!gpu->dispatch(iir_kern,
+                       {gpu::Arg::buf(img_T->buf), gpu::Arg::buf(coef_buf), gpu::Arg::buf(act_buf),
+                        gpu::Arg::buf(img_T->buf), gpu::Arg::buf(wt_buf),
+                        gpu::Arg::inline_bytes(meta_h_t, 4), gpu::Arg::buf(tmp_T.buf)},
+                       size_t(img_T->w) * 3, error)) return false;
+
+    // Release temporary owned_T early if we created it.
+    owned_T = Image{};
+
+    // Transpose back (W, H) -> (H, W) directly into out.
+    if (!transpose3(gpu, tmp_T, out, error)) return false;
+    tmp_T = Image{};
+
+    // Pass 2 (vertical axis=0 on (H, W), in-place on out, carrying accumulate/weight):
+    const uint32_t meta_v[4] = {img.h, img.w, acc ? 1u : 0u, 0u};
+    if (!gpu->dispatch(iir_kern,
+                       {gpu::Arg::buf(out.buf), gpu::Arg::buf(coef_buf), gpu::Arg::buf(act_buf),
+                        gpu::Arg::buf(dummy->buf), gpu::Arg::buf(wt_buf),
+                        gpu::Arg::inline_bytes(meta_v, 4), gpu::Arg::buf(out.buf)},
+                       size_t(img.w) * 3, error)) return false;
+
+    if (sweep_report) {
+        sweep_report->bands.push_back({0, img.h});
+        sweep_report->launches += 2;
+    }
+    return true;
+}

+bool transpose3(gpu::Gpu* gpu, const Image& src, Image& dst, std::string& error) {
+    dst.h = src.w;
+    dst.w = src.h;
+    dst.c = src.c;
+    dst.buf = gpu->alloc(src.bytes(), error);
+    if (!dst.buf) return false;
+    const uint32_t tiles_x = (src.w + 15u) >> 4u;
+    const uint32_t tiles_y = (src.h + 15u) >> 4u;
+    const uint32_t meta[2] = {src.h, src.w};
+    return gpu->dispatch("spk_transpose3",
+                         {gpu::Arg::buf(src.buf), gpu::Arg::inline_bytes(meta, 2), gpu::Arg::buf(dst.buf)},
+                         size_t(tiles_x) * size_t(tiles_y) * 256u, error);
+}
+
+bool box_down2(gpu::Gpu* gpu, const Image& src, Image& dst, std::string& error) {
+    dst.h = std::max(1u, (src.h + 1u) >> 1u);
+    dst.w = std::max(1u, (src.w + 1u) >> 1u);
+    dst.c = src.c;
+    dst.buf = gpu->alloc(dst.bytes(), error);
+    if (!dst.buf) return false;
+    const uint32_t meta[4] = {src.h, src.w, dst.h, dst.w};
+    return gpu->dispatch("spk_box_down2",
+                         {gpu::Arg::buf(src.buf), gpu::Arg::inline_bytes(meta, 4), gpu::Arg::buf(dst.buf)},
+                         dst.pixels(), error);
+}
